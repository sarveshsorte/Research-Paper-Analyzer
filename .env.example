# ClaimLens backend settings. Copy to .env (git-ignored) and fill in the keys.
# Without any keys the app still works end to end: local embeddings and
# answers quoted straight from the papers. Add keys for NVIDIA embeddings and
# Nemotron answers.

# Application
APP_ENV=development
LOG_LEVEL=INFO
# SQLite database for users, documents, chunks, chunk vectors and jobs
STORAGE_PATH=storage/researchlens.sqlite3
# The document pipeline's BM25 (SQLite FTS5) index
BM25_INDEX_PATH=storage/bm25/index.sqlite3

# Embeddings: an OpenAI-compatible /embeddings API (NVIDIA API Catalog here).
# Use the exact model id from build.nvidia.com, for example
# nvidia/llama-3.2-nv-embedqa-1b-v2 (2048 dims); the dimension must match.
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048
# auto: send input_type (query/passage) to nvidia.com endpoints; on / off
EMBEDDING_INPUT_TYPE=auto

# Answers, comparisons, conflicts and claim judgements: Nemotron on
# Nebius Token Factory (OpenAI-compatible chat completions)
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_API_KEY=
# The Nemotron model id exactly as Token Factory lists it
NEBIUS_MODEL=

# Claim checks: paper search. Semantic Scholar and arXiv work without keys;
# a Semantic Scholar key raises its rate limit. Tavily needs a key.
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=
# Extra hosts open-access PDFs may be downloaded from (comma-separated)
DOWNLOAD_ALLOWED_HOSTS=

# Firebase Authentication. Download the service-account JSON from Firebase
# console > Project settings > Service accounts, save it under secrets/
# (git-ignored) and point FIREBASE_CREDENTIALS_PATH at it.
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=

# Background work (the API runs as one process)
JOB_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=180
CHECK_TIMEOUT_SECONDS=600
PROCESS_CONCURRENCY=2

# Used only by the query pipeline's own /workspaces/{id}/query route
USE_FAKE_PROVIDERS=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=paper_chunks
