# Copy to .env to override. When a variable is unset, the app uses the value shown here.
VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_USE_MOCKS=false
VITE_ENABLE_CLAIM_MODE=true
VITE_ENABLE_FETCH_BY_LINK=true

# Firebase web app (Firebase console > Project settings > Your apps). These identify the project
# and are not secrets, but they differ per project, so there is no default: without them only the
# live demo can sign in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
