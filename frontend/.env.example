# Copy to .env to override. When a variable is unset, the app uses the value shown here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false
VITE_ENABLE_CLAIM_MODE=true
VITE_ENABLE_FETCH_BY_LINK=true

# Firebase Web App (Firebase Console > Project Settings > General > Your Apps > Web App)
# Optional: if omitted, ClaimLens runs in Demo Mode (guest access without login).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
